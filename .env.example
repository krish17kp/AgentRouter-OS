# AgentRouter OS — environment variables
# MVP needs NO secrets: adapters run catalog-only (planner, not executor).

# Override the data/config home (default: ~/.agentrouter)
# AGENTROUTER_HOME=

# Optional browser UI integration. Comma-separated, explicit origins only; no
# CORS header is emitted unless this is set. Example for `website/` Vite dev:
# AGENTROUTER_CORS_ORIGINS=http://localhost:5173

# --- Capstone tier and later (providers refresh / execution) — unused in MVP ---
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=your_openrouter_api_key_here
